# TransitPro — variables d'environnement (copiez ce fichier en `.env`)
# Toutes les variables sont optionnelles.

# Port HTTP de l'API (l'interface est servie par le même serveur en production)
PORT=3001

# Emplacement de la base de données SQLite
# DATA_DIR=data
# DB_PATH=data/app.db

# Dossier des fichiers téléversés (documents)
# UPLOAD_DIR=uploads
